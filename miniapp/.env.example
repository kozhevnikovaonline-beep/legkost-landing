# Адрес бэкенда (папка server/). Пусто — приложение работает в демо-режиме:
# прогресс хранится в Telegram CloudStorage + localStorage, оплата демонстрационная.
VITE_API_URL=

# Юзернейм бота без @ — для реферальных ссылок и кнопки «Написать в бот»
VITE_BOT_USERNAME=legkost_guide_bot
# Короткое имя Mini App из BotFather (/newapp) — для ссылок t.me/<bot>/<app>
VITE_APP_SHORTNAME=app
# Канал Алёны (задание «Подписаться на канал»)
VITE_CHANNEL_URL=https://t.me/legkost_vetrova
# Личный контакт куратора
VITE_CURATOR_URL=https://t.me/legkost_guide_bot
