# Токен бота из @BotFather
BOT_TOKEN=
# Адрес, где лежит собранное приложение (GitHub Pages или свой домен), https обязателен
WEBAPP_URL=https://kozhevnikovaonline-beep.github.io/legkost-landing/app/
# Порт API
PORT=8080
# Откуда разрешены запросы (по умолчанию — origin WEBAPP_URL)
# ALLOWED_ORIGIN=https://kozhevnikovaonline-beep.github.io
# Платёжный токен из BotFather → Payments (ЮKassa и др.). Пусто — оплата выключена
PAYMENT_PROVIDER_TOKEN=
# 1 — демо-оплата без денег (ТОЛЬКО для тестов)
DEMO_PAYMENTS=0
# 0 — не запускать long polling (если используете вебхук)
BOT_POLLING=1
